index b7b3ba3..0be8bf9 100644
--- a/build.py
+++ b/build.py
@@ -121,6 +121,14 @@ VISTA3D_OUT = DIST_DIR / "3d"
 MAPLIBRE_DIR = SCRIPT_DIR / "vendor" / "maplibre-gl"
 MARKER_VISTA3D_CSS = "/*<<VISTA_3D_CSS>>*/"
