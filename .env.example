# Copia questo file in .env.local e metti i tuoi valori (.env.local NON va committato)
# Tutti i database li crea db/init.sql (vedi docs/SETUP.md); la password è quella del ruolo romarouter.

# Database generale (usato solo dal controllo /api/health)
DATABASE_URL=postgresql://romarouter:LA_TUA_PASSWORD@localhost:5432/romarouter

# Un database per sezione del sito
DATABASE_URL_ANTENNE=postgresql://romarouter:LA_TUA_PASSWORD@localhost:5432/rr_antenne
DATABASE_URL_ARTISTI=postgresql://romarouter:LA_TUA_PASSWORD@localhost:5432/rr_artisti_strada
DATABASE_URL_SPORT=postgresql://romarouter:LA_TUA_PASSWORD@localhost:5432/rr_impianti_sportivi
DATABASE_URL_SMARRITI=postgresql://romarouter:LA_TUA_PASSWORD@localhost:5432/rr_oggetti_smarriti
